# ── Frontend Mode & API ─────────────────────────────────────────────
# Set to 'false' to connect the UI directly to your live backend database & Gemini AI.
# Set to 'true' to use static local fixtures without running the backend.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=http://localhost:3001

# Google Identity Services OAuth client ID (Web application client)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Backend Database (MongoDB or PostgreSQL) ─────────────────────────
# MongoDB connection URI (e.g. MongoDB Atlas or local MongoDB)
# When set, SentinelMail stores cases, vendors, indicators, and campaigns natively in MongoDB.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sentinelmail?retryWrites=true&w=majority
# MONGODB_DB_NAME=sentinelmail

# PostgreSQL connection (alternative relational database option)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelmail

# Express API server port (default 3001)
API_PORT=3001

# ── AI Forensic Classification (Google Gemini or OpenAI) ─────────────
# Google Gemini API Key (Recommended for BEC forensic analysis)
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (alternative LLM fallback)
# OPENAI_API_KEY=sk-...

# ── Containment Alerts (all optional) ───────────────────────────────
# CONTAINMENT_WEBHOOK_URL=https://your-webhook-endpoint
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=your-password
# SMTP_FROM=SentinelMail <alerts@example.com>
# ALERT_EMAIL_TO=finance-team@example.com
