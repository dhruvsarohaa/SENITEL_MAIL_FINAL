# ==============================================================================
# SentinelMail Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration (Express Backend)
# ------------------------------------------------------------------------------
PORT=3001
# API_PORT=3001

# ------------------------------------------------------------------------------
# Database Options (PostgreSQL, MongoDB, or Zero-Config In-Memory Fallback)
# ------------------------------------------------------------------------------
# PostgreSQL (Primary relational store with multi-tenancy & migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelmail

# MongoDB (Alternative document store)
# MONGODB_URI=mongodb://localhost:27017/sentinelmail
# MONGODB_DB_NAME=sentinelmail

# ------------------------------------------------------------------------------
# AI & LLM Forensic Classification Providers
# ------------------------------------------------------------------------------
# Google Gemini (Primary priority)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Secondary fallback)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# IP Intelligence & Geolocation
# ------------------------------------------------------------------------------
# Get your free token at https://ipinfo.io/
IPINFO_TOKEN=

# ------------------------------------------------------------------------------
# Authentication & Enterprise Security
# ------------------------------------------------------------------------------
# Firebase Admin SDK Service Account JSON string for token verification
FIREBASE_SERVICE_ACCOUNT_JSON=

# Ingestion / API Key secret for headless mail poller / connectors
SENTINEL_API_KEY=
SENTINEL_API_URL=http://localhost:3001
SENTINEL_TENANT_ID=sentinel-corp

# ------------------------------------------------------------------------------
# Containment & Emergency Incident Alerts
# ------------------------------------------------------------------------------
CONTAINMENT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# SMTP Email Dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=security-alerts@sentinelmail.io
ALERT_EMAIL_TO=incident-response@sentinelmail.io

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite & TanStack Start)
# ------------------------------------------------------------------------------
# API Base URL (leave empty to use relative same-origin /api proxy)
VITE_API_BASE_URL=

# Offline Demo Mode (Set to true to bypass backend and use local fixtures)
VITE_DEMO_MODE=false

# Google Sign-In & Firebase Client Credentials
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Deployment Host Header Validation
ALLOWED_HOSTS=localhost,127.0.0.1
